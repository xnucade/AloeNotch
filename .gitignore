# --- macOS ---
.DS_Store
._*
.AppleDouble
.LSOverride
Icon?

# --- Xcode ---
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa

# --- Build artifacts (regenerate with scripts/make-dmg.sh) ---
*.dmg

# --- Rendered demo video (regenerate with video/build.sh) ---
# Several MB of binary that would bloat every clone, and it is fully
# reproducible from video/. Like the DMG, it reaches users only via the
# deployed site. Run `cd video && ./build.sh` before deploying a fresh clone.
# The poster stays tracked: it is small and gives the page a still to show.
site/assets/demo.mp4
site/assets/demo.webm

# Same rule for the per-feature card clips: the encoded video is reproducible
# (`cd video/clips && node render-clips.mjs`), the posters are small and are
# tracked so a fresh clone still renders the grid rather than ten empty boxes.
site/assets/clips/*.mp4
site/assets/clips/*.webm

# --- /brag output (regenerate with the brag skill) ---
# Same rule again: the render and the Hyperframes scratch are reproducible
# binaries. The plan, the brief, the composition source and the poster are
# small and worth keeping; release.sh does `git add -A`, so without this the
# next ship would commit several MB of video to a public repo by accident.
# Renders and their scratch. The previous rule only named brag.mp4 and one
# composition directory, so a second cut and its bundled music went into a
# public repo — 18.9 MB of reproducible binary. Match by kind, not by name.
brag-output*/*.mp4
brag-output*/*.webm
brag-output*/composition*/snapshots/
brag-output*/composition*/node_modules/
brag-output*/composition*/.frames/
# Bundled music and sound effects come from the brag skill, not from us.
brag-output*/composition*/assets/music/*.mp3
brag-output*/composition*/assets/sfx/

# --- Node / Wrangler (site) ---
node_modules/
.wrangler/
.dev.vars
.dev.vars.*

# --- Secrets / local env (never commit) ---
.env
.env.*
*.pem
*.key
secrets.*
*.p12
*.mobileprovision

# --- Raw working media (not part of the app/site; may show desktop contents) ---
Media/

# --- Editors / tooling ---
.vscode/
.idea/
.claude/settings.local.json
